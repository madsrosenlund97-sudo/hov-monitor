# Local credentials for monitor.js. Copy to .env (gitignored).
# Used by the wp-admin / Amelia bookings monitor check.
WP_USER=your-wp-admin@example.com
WP_PASS=your-wp-password

# Netlify deploy (used by sync-now script + netlify-login.js helper)
NETLIFY_LOGIN_EMAIL=your-netlify@example.com
NETLIFY_LOGIN_PASS=your-netlify-password
NETLIFY_AUTH_TOKEN=
