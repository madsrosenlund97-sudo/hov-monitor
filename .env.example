# Local credentials. Copy to .env (gitignored) before running locally.
# GitHub Actions reads the same names from repo secrets.

# --- Frontend monitor (monitor.js) -----------------------------------------
# Pings public pages. No auth needed.

# --- Admin/bookings monitor (check-bookings.js) ----------------------------
# Scrapes /admin/bookings on the Next.js frontend (Basic Auth + Vercel
# Protection Bypass for Automation).
VERCEL_BYPASS_SECRET=
ADMIN_USER=mads@houseofvinterberg.com
ADMIN_PASS=

# --- WooCommerce orders monitor (check-orders.js) --------------------------
# Reads orders via WC REST API on drift.houseofvinterberg.com.
# Create keys in WooCommerce -> Settings -> Advanced -> REST API.
WC_KEY=
WC_SECRET=
# Optional override; defaults to https://drift.houseofvinterberg.com
# WC_BASE_URL=

# --- Pushover --------------------------------------------------------------
# One user key, three separate app tokens so each notification channel can
# be muted independently on the phone.
PUSHOVER_USER=
PUSHOVER_TOKEN_WEBSITE=
PUSHOVER_TOKEN_BOOKING=
PUSHOVER_TOKEN_WEBSHOP=

# --- Telegram --------------------------------------------------------------
# Brug en bot + gruppe-chat så flere modtagere får samme notifikation uden at
# skulle dele konto. Opret bot via @BotFather, tilføj den til en gruppe, og find
# gruppe-ID med `node get-telegram-chat-id.js`.
#
# Per-stream overrides: hver stream (website/booking/webshop) kan bruge sin egen
# bot+gruppe. Hvis _STREAM ikke er sat, falder den tilbage til TELEGRAM_BOT_TOKEN /
# TELEGRAM_CHAT_ID. Hvis du KUN bruger overrides kan default-felterne være tomme.
#
# Typisk to-bot opsætning:
#   Bot 1 (web alerts) -> TELEGRAM_BOT_TOKEN_WEBSITE + TELEGRAM_CHAT_ID_WEBSITE
#   Bot 2 (bookings + webshop) -> TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID
#                                 (gælder for både booking og webshop streams)
# Eller hvis bookings og webshop skal i hver sin gruppe (samme bot):
#   TELEGRAM_BOT_TOKEN (bot 2) + TELEGRAM_CHAT_ID_BOOKING + TELEGRAM_CHAT_ID_WEBSHOP
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN_WEBSITE=
TELEGRAM_CHAT_ID_WEBSITE=
TELEGRAM_BOT_TOKEN_BOOKING=
TELEGRAM_CHAT_ID_BOOKING=
TELEGRAM_BOT_TOKEN_WEBSHOP=
TELEGRAM_CHAT_ID_WEBSHOP=
