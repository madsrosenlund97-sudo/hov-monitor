# Local credentials. Copy to .env (gitignored) before running locally.
# GitHub Actions reads the same names from repo secrets.

# --- Frontend monitor (monitor.js) -----------------------------------------
# Pings public pages. No auth needed.

# --- Admin/bookings monitor (check-bookings.js) ----------------------------
# Scrapes /admin/bookings on the Next.js frontend (Basic Auth + Vercel
# Protection Bypass for Automation).
VERCEL_BYPASS_SECRET=
ADMIN_USER=mads@houseofvinterberg.com
ADMIN_PASS=

# --- WooCommerce orders monitor (check-orders.js) --------------------------
# Reads orders via WC REST API on drift.houseofvinterberg.com.
# Create keys in WooCommerce -> Settings -> Advanced -> REST API.
WC_KEY=
WC_SECRET=
# Optional override; defaults to https://drift.houseofvinterberg.com
# WC_BASE_URL=

# --- Pushover --------------------------------------------------------------
# One user key, three separate app tokens so each notification channel can
# be muted independently on the phone.
PUSHOVER_USER=
PUSHOVER_TOKEN_WEBSITE=
PUSHOVER_TOKEN_BOOKING=
PUSHOVER_TOKEN_WEBSHOP=
