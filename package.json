{
  "name": "hov-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend monitor for houseofvinterberg.com",
  "scripts": {
    "check": "node monitor.js",
    "test-alert": "node monitor.js --simulate-fail",
    "scrape": "node scrape-bookings.js",
    "enrich": "node enrich-orders.js",
    "refresh": "node scrape-bookings.js && node enrich-orders.js",
    "sync-now": "node scrape-bookings.js && node enrich-orders.js && cd ../HOV-Daily-Checklist && npx --yes vercel@latest deploy --prod --yes"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  }
}
