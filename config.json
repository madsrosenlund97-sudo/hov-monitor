{
  "site": "https://houseofvinterberg.com",
  "pages": [
    { "path": "/",                       "mustContain": ["Vinterberg"] },
    { "path": "/book",                   "mustContain": ["Book"] },
    { "path": "/formal-clothing",        "mustContain": ["Vinterberg"] },
    { "path": "/casual-clothing",        "mustContain": ["Vinterberg"] },
    { "path": "/bryllup",                "mustContain": ["Bryllup"] },
    { "path": "/wardrobe-service",       "mustContain": ["Wardrobe"] },
    { "path": "/en",                     "mustContain": ["Vinterberg"] },
    { "path": "/en/book",                "mustContain": ["Book"] },
    { "path": "/en/formal-clothing",     "mustContain": ["Vinterberg"] },
    { "path": "/en/wardrobe-service",    "mustContain": ["Wardrobe"] }
  ],
  "concurrency": 1,
  "minFailStreakForAlert": 3,
  "timeoutMs": 30000,
  "maxLoadMs": 20000,
  "userAgent": "Mozilla/5.0 (HOV-Monitor; +https://houseofvinterberg.com) AppleWebKit/537.36",
  "ignoredConsoleErrors": [
    "favicon",
    "gtag",
    "google-analytics",
    "googletagmanager",
    "googlesyndication",
    "pagead2",
    "doubleclick",
    "googleadservices",
    "facebook.net",
    "facebook.com/tr",
    "connect.facebook.net",
    "hotjar",
    "klaviyo",
    "robots.txt",
    "tiktok",
    "snap.licdn",
    "report-only content security policy",
    "csp.withgoogle.com"
  ],
  "ignoredFirstPartyErrors": [],
  "alertCooldownMinutes": 30,
  "slackWebhookUrl": "",
  "emailWebhookUrl": ""
}
